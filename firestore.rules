rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read construction updates, offers, and legal pages
    match /constructionUpdates/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /offers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /legal/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can write a lead, but ONLY admins can read or delete leads
    match /leads/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Admin user profiles - only authenticated admins can read/write
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}