rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Anyone can view images
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Only authenticated admins can upload/delete images
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}